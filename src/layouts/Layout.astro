---
import "../styles/global.scss";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Excode</title>
  </head>
  <body>
    <div class="wrapper">
      <header class="header">
        <div class="logo">
          <a href="/">
            <img src="/logo.svg" alt="Logo" width="48" height="48" />
            Excode
          </a>
        </div>
      </header>
    </div>
    <slot />
  </body>
</html>

<style>
  .header {
    position: fixed;
    top: 0px;
    width: 100%;
    padding: 16px 32px;
    display: flex;
    align-items: center;
    background: #f7f9fa;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
  }

  .logo a {
    all: unset;
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 32px;
  }

  .logo img {
    display: block;
    height: 48px;
    width: auto;
  }

  .wrapper {
    margin-top: 80px;
  }
</style>
