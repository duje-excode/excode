---
const title = "Let's make things happen";
const subtitle = "Reach out today to learn how our web development services can help you build fast, modern and scalable digital products.";
const cta = "Get your free proposal";
---

<section class="container">
    <div class="wrapper">
        <div>
            <h2>{title}</h2>
            <p>{subtitle}</p>
            <a href="#contact-form"><button class="btn">{cta}</button></a>
        </div>
        <div class="content">
            <img src="/src/assets/cta.svg" alt="Cta" />
        </div>
    </div>
</section>

<style lang="scss">
    .content {
        width: 100%;
        max-width: 350px;
    }

    .wrapper {
        display: flex;
        align-items: center;
        gap: 30px;
        justify-content: center;
        border: 2px solid #dcdcdc;
        background: #f2f2f2;
        border-radius: 50px;
        padding: 40px;
    }

    h2 {
        font-size: 28px;
        margin: 5px 0px;
    }

    p {
        font-size:20px;
    }

    .btn {
        all: unset;
        display: inline-block;
        cursor: pointer;
        font-size:17px;
        color: black;
        padding: 8px 16px;
        border-radius: 4px;
        border: 1px solid #18181b;
        transition:
        background-color 0.3s ease,
        transform 0.2s ease;

        &:hover {
        background-color: #18181b;
        color: #fff;
        }
    }

    @media only screen and (max-width: 768px) {
        .wrapper {
            flex-direction: column;
        }

        .container {
            padding: 100px 10px;
        }
    }

</style>