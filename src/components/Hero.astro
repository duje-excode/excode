---
const title = "Take your business to the next level";
const subtitle =
  "We do the research, pick the right techonology, design and build solutions that deliver measurable results.";
const cta = "Book a consultation";
---

<section class="container wrapper flex-center">
  <div class="content">
    <h1>{title}</h1>
    <p>{subtitle}</p>
    <button class="btn">{cta}</button>
  </div>
  <div class="content">
    <img src="/src/assets/hero.svg" alt="Hero" />
  </div>
</section>

<style lang="scss">
  h1 {
    font-size: 60px;
  }

  p {
    font-size: 18px;
  }

  .wrapper {
    display: flex;
    align-items: center;
    gap: 30px;
    justify-content: center;
  }

  .content {
    width: 50%;
  }

  .btn {
    all: unset;
    display: block;
    cursor: pointer;
    padding: 8px 16px;
    border-radius: 4px;
    border: 1px solid #18181b;
    transition:
      background-color 0.3s ease,
      transform 0.2s ease;

    &:hover {
      background-color: #18181b;
      color: #fff;
    }
  }

  @media only screen and (max-width: 768px) {
    h1 {
      font-size: 36px;
      text-align: center;
      padding: 0 30px;
    }

    p {
      text-align: center;
      padding: 0 30px;
    }

    .wrapper {
      gap: 0;
      flex-direction: column-reverse;
      padding-left: 10px;
      padding-right: 10px;
    }

    .content {
      width: 100%;
    }

    .btn {
      margin: 0 auto;
    }
  }
</style>
